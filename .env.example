# Path to the fine-tuned classifier directory (created by `sentinel train`). Unset = rules-only mode.
SENTINEL_MODEL_DIR=models/sentinel-minilm
# Audit log location (JSON lines).
SENTINEL_AUDIT_LOG=logs/audit.jsonl
# Store the first N characters of each screened text in the audit log (0 = hash only).
SENTINEL_AUDIT_TEXT_CHARS=200
# Proxy mode: the proxy refuses to forward anything unless this is set.
# Example: https://api.openai.com/v1  (or any OpenAI-compatible server, e.g. a local one)
SENTINEL_UPSTREAM_BASE_URL=
# Optional key the proxy uses upstream when the caller sends none. Never logged.
SENTINEL_UPSTREAM_API_KEY=
